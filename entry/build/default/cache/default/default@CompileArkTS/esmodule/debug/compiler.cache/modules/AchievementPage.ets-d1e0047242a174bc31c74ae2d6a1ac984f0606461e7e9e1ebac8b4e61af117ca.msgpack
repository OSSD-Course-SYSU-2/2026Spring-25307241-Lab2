    // æ ¼å¼åŒ–æ—¶é—´
    formatTime(seconds) {
        if (seconds === 0)
            return '0åˆ†é’Ÿ';
        if (seconds < 60)
            return `${seconds}ç§’`;
        const hours = Math.floor(seconds / 3600);
        const mins = Math.floor((seconds % 3600) / 60);
        if (hours > 0) {
            return mins > 0 ? `${hours}å°æ—¶${mins}åˆ†` : `${hours}å°æ—¶`;
        }
        return `${mins}åˆ†é’Ÿ`;
    }

import router from '@ohos.router';
import { LeaderboardManager } from '../common/util/LeaderboardManager';
import { LeaderboardEntry, MedalType } from '../viewmodel/PuzzleGameModel';

@Entry
@Component
struct LeaderboardPage {
  @State leaderboard: LeaderboardEntry[] = [];
  @State isLoading: boolean = true;
  @State currentTab: number = 0; // 0: å…¨çƒæ’è¡Œ, 1: ä»Šæ—¥æ’è¡Œ

  aboutToAppear(): void {
    this.loadLeaderboard();
  }

  async loadLeaderboard(): Promise<void> {
    this.isLoading = true;
    this.leaderboard = await LeaderboardManager.getLeaderboard();
    this.isLoading = false;
  }

  getMedalIcon(type: MedalType): string {
    switch (type) {
      case MedalType.GOLD:
        return 'ğŸ¥‡';
      case MedalType.SILVER:
        return 'ğŸ¥ˆ';
      case MedalType.BRONZE:
        return 'ğŸ¥‰';
      default:
        return 'ğŸ…';
    }
  }

  getRankIcon(rank: number): string {
    switch (rank) {
      case 1:
        return 'ğŸ¥‡';
      case 2:
        return 'ğŸ¥ˆ';
      case 3:
        return 'ğŸ¥‰';
      default:
        return `${rank}`;
    }
  }

  build() {
    Column() {
      // é¡¶éƒ¨å¯¼èˆª
      Row() {
        Button() {
          Text('â†')
            .fontSize(24)
            .fontColor(Color.White)
        }
        .width(40)
        .height(40)
        .backgroundColor('rgba(255,255,255,0.2)')
        .borderRadius(20)
        .onClick(() => {
          router.back();
        })

        Blank().layoutWeight(1)

        Text('ğŸ† æ’è¡Œæ¦œ')
          .fontSize(20)
          .fontColor(Color.White)
          .fontWeight(FontWeight.Bold)

        Blank().layoutWeight(1)

        Blank().width(40)
      }
      .width('100%')
      .height(80)
      .padding({ left: 20, right: 20 })

      // æ ‡ç­¾åˆ‡æ¢
      Row() {
        Button('å…¨çƒæ’è¡Œ')
          .width('45%')
          .height(40)
          .backgroundColor(this.currentTab === 0 ? 'rgba(255,255,255,0.3)' : 'rgba(255,255,255,0.1)')
          .borderRadius(20)
          .fontColor(Color.White)
          .onClick(() => {
            this.currentTab = 0;
          })

        Button('ä»Šæ—¥æ’è¡Œ')
          .width('45%')
          .height(40)
          .backgroundColor(this.currentTab === 1 ? 'rgba(255,255,255,0.3)' : 'rgba(255,255,255,0.1)')
          .borderRadius(20)
          .fontColor(Color.White)
          .onClick(() => {
            this.currentTab = 1;
          })
      }
      .width('90%')
      .justifyContent(FlexAlign.SpaceEvenly)
      .margin({ bottom: 20 })

      // æ’è¡Œæ¦œåˆ—è¡¨
      if (this.isLoading) {
        Column() {
          LoadingProgress()
            .width(50)
            .height(50)
            .color(Color.White)

          Text('åŠ è½½ä¸­...')
            .fontSize(16)
            .fontColor('rgba(255,255,255,0.8)')
            .margin({ top: 15 })
        }
        .width('100%')
        .layoutWeight(1)
        .justifyContent(FlexAlign.Center)
      } else {
        Column() {
          // è¡¨å¤´
          Row() {
            Text('æ’å')
              .fontSize(14)
              .fontColor('rgba(255,255,255,0.7)')
              .width('15%')
              .textAlign(TextAlign.Center)

            Text('ç©å®¶')
              .fontSize(14)
              .fontColor('rgba(255,255,255,0.7)')
              .width('30%')
              .textAlign(TextAlign.Center)

            Text('åˆ†æ•°')
              .fontSize(14)
              .fontColor('rgba(255,255,255,0.7)')
              .width('25%')
              .textAlign(TextAlign.Center)

            Text('ç”¨æ—¶')
              .fontSize(14)
              .fontColor('rgba(255,255,255,0.7)')
              .width('15%')
              .textAlign(TextAlign.Center)

            Text('å¥–ç‰Œ')
              .fontSize(14)
              .fontColor('rgba(255,255,255,0.7)')
              .width('15%')
              .textAlign(TextAlign.Center)
          }
          .width('95%')
          .padding({ top: 10, bottom: 10 })
          .backgroundColor('rgba(255,255,255,0.1)')
          .borderRadius({ topLeft: 10, topRight: 10 })

          // åˆ—è¡¨
          List() {
            ForEach(this.leaderboard, (entry: LeaderboardEntry, index: number) => {
              ListItem() {
                Row() {
                  // æ’å
                  Column() {
                    Text(this.getRankIcon(index + 1))
                      .fontSize(index < 3 ? 24 : 16)
                  }
                  .width('15%')
                  .justifyContent(FlexAlign.Center)

                  // ç©å®¶å
                  Text(entry.playerName)
                    .fontSize(14)
                    .fontColor(Color.White)
                    .fontWeight(index < 3 ? FontWeight.Bold : FontWeight.Normal)
                    .width('30%')
                    .textAlign(TextAlign.Center)

                  // åˆ†æ•°
                  Text(`${entry.score}`)
                    .fontSize(16)
                    .fontColor(Color.White)
                    .fontWeight(FontWeight.Bold)
                    .width('25%')
                    .textAlign(TextAlign.Center)

                  // ç”¨æ—¶
                  Text(this.formatTime(entry.time))
                    .fontSize(14)
                    .fontColor('rgba(255,255,255,0.8)')
                    .width('15%')
                    .textAlign(TextAlign.Center)

                  // å¥–ç‰Œ
                  Text(this.getMedalIcon(entry.medal))
                    .fontSize(20)
                    .width('15%')
                    .textAlign(TextAlign.Center)
                }
                .width('95%')
                .height(60)
                .backgroundColor(index % 2 === 0 ? 'rgba(255,255,255,0.15)' : 'rgba(255,255,255,0.05)')
                .borderRadius(index === this.leaderboard.length - 1 ? 10 : 0)
              }
            })
          }
          .width('95%')
          .layoutWeight(1)
          .divider({
            strokeWidth: 1,
            color: 'rgba(255,255,255,0.1)'
          })
        }
        .width('100%')
        .layoutWeight(1)
        .justifyContent(FlexAlign.Start)
        .padding({ top: 10 })
      }

      // åº•éƒ¨æç¤º
      Column() {
        Text('ğŸ’¡ æ¯æ—¥æŒ‘æˆ˜å®Œæˆåè‡ªåŠ¨ä¸Šä¼ åˆ†æ•°')
          .fontSize(13)
          .fontColor('rgba(255,255,255,0.7)')
      }
      .width('100%')
      .height(60)
      .justifyContent(FlexAlign.Center)
    }
    .width('100%')
    .height('100%')
    .linearGradient({
      angle: 135,
      colors: [['#667eea', 0.0], ['#764ba2', 1.0]]
    })
  }

  formatTime(seconds: number): string {
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${mins}:${secs.toString().padStart(2, '0')}`;
  }
}

              .fontColor('rgba(255,255,255,0.8)')
          }
          .width('100%')
          .padding(15)
          .backgroundColor('rgba(255,255,255,0.1)')
          .borderRadius(10)
        }
        .width('100%')
        .padding({ left: 15, right: 15, bottom: 15 })
      }
    }
    .width('100%')
    .backgroundColor('rgba(255,255,255,0.1)')
    .borderRadius(15)
    .margin({ bottom: 15 })
  }

  // æ¸¸æˆæ¨¡å¼
  @Builder
  buildGameModes() {
    Column() {
      Row() {
        Text('æ¸¸æˆæ¨¡å¼')
          .fontSize(20)
          .fontWeight(FontWeight.Bold)
          .fontColor(Color.White)

        Blank().layoutWeight(1)

        Text(this.currentSection === 4 ? 'â–¼' : 'â–¶')
          .fontSize(16)
          .fontColor('rgba(255,255,255,0.7)')
      }
      .width('100%')
      .padding(15)
      .onClick(() => {
        this.currentSection = this.currentSection === 4 ? -1 : 4;
      })

      if (this.currentSection === 4) {
        Column() {
          this.buildModeItem('ðŸŽ® ç»å…¸æ¨¡å¼', [
            'éšæ—¶å¼€å¯éšæœºç”Ÿæˆçš„è§£è°œå…³å¡',
            'è‡ªç”±ç»ƒä¹ ï¼Œæ— æ¯æ—¥é™åˆ¶',
            'åˆ·é«˜åˆ†ï¼Œå†²é‡‘ç‰Œ',
            'é€‚åˆæ–°æ‰‹ç†Ÿæ‚‰æ¸¸æˆ'
          ])

          this.buildModeItem('ðŸ† æ¯æ—¥æŒ‘æˆ˜', [
            'æ¯å¤©å…¨çƒçŽ©å®¶å…±ç”¨åŒä¸€é“è°œé¢˜',
            'å®ŒæˆåŽè‡ªåŠ¨ä¸Šä¼ åˆ†æ•°åˆ°å…¨çƒæŽ’è¡Œæ¦œ',
            'å’Œå…¨ä¸–ç•ŒçŽ©å®¶æ¯”æ‹¼æŽ’å',
            'çœ‹è°çš„æ»‘å†°è¡¨æ¼”æ›´å®Œç¾Ž'
          ])
        }
        .width('100%')
        .padding({ left: 15, right: 15, bottom: 15 })
      }
    }
    .width('100%')
    .backgroundColor('rgba(255,255,255,0.1)')
    .borderRadius(15)
    .margin({ bottom: 15 })
  }

  @Builder
  buildRuleItem(icon: string, desc: string) {
    Row() {
      Text(icon)
        .fontSize(24)

      Text(desc)
        .fontSize(14)
        .fontColor('rgba(255,255,255,0.9)')
        .margin({ left: 15 })
        .layoutWeight(1)
    }
    .width('100%')
    .padding(10)
  }

  @Builder
  buildCardItem(name: string, desc: string, difficulty: number) {
    Row() {
      Column() {
        Text(name)
          .fontSize(15)
          .fontWeight(FontWeight.Bold)
          .fontColor(Color.White)

        Text(desc)
          .fontSize(13)
          .fontColor('rgba(255,255,255,0.8)')
          .margin({ top: 3 })
      }
      .alignItems(HorizontalAlign.Start)
      .layoutWeight(1)

      Text(`éš¾åº¦${difficulty}`)
        .fontSize(12)
        .fontColor('rgba(255,255,255,0.7)')
        .padding({ left: 8, right: 8, top: 4, bottom: 4 })
        .backgroundColor('rgba(255,255,255,0.2)')
        .borderRadius(10)
    }
    .width('100%')
    .padding(10)
    .backgroundColor('rgba(255,255,255,0.05)')
    .borderRadius(8)
    .margin({ bottom: 8 })
  }

  @Builder
  buildMedalItem(medal: string, desc: string) {
    Row() {
      Text(medal)
        .fontSize(24)

      Text(desc)
        .fontSize(14)
        .fontColor('rgba(255,255,255,0.9)')
        .margin({ left: 15 })
        .layoutWeight(1)
    }
    .width('100%')
    .padding(12)
    .backgroundColor('rgba(255,255,255,0.1)')
    .borderRadius(10)
    .margin({ bottom: 10 })
  }

  @Builder
  buildModeItem(title: string, features: string[]) {
    Column() {
      Text(title)
        .fontSize(18)
        .fontWeight(FontWeight.Bold)
        .fontColor(Color.White)
        .margin({ bottom: 10 })

      Column() {
        ForEach(features, (feature: string, index: number) => {
          Row() {
            Text('âœ“')
              .fontSize(14)
              .fontColor('#4CAF50')

            Text(feature)
              .fontSize(14)
              .fontColor('rgba(255,255,255,0.9)')
              .margin({ left: 8 })
          }
          .width('100%')
          .margin({ bottom: 5 })
        }, (feature: string, index: number) => `${title}_${index}`)
      }
      .width('100%')
    }
    .width('100%')
    .padding(15)
    .backgroundColor('rgba(255,255,255,0.1)')
    .borderRadius(10)
    .margin({ bottom: 15 })
    .alignItems(HorizontalAlign.Start)
  }
}

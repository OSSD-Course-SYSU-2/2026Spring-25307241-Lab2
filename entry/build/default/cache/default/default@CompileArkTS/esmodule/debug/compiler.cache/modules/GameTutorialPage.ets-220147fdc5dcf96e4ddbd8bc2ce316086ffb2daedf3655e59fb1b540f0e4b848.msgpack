    .width('100%')
    .padding(15)
    .backgroundColor('rgba(255,255,255,0.1)')
    .borderRadius(15)
    .margin({ top: 15 })
  }
  
  @Builder
  buildDemoCards() {
    Column() {
      Text('ðŸŽ´ åŠ¨ä½œå¡ç‰Œ')
        .fontSize(16)
        .fontColor(Color.White)
        .fontWeight(FontWeight.Bold)
        .margin({ bottom: 10 })
      
      Row() {
        ForEach(this.handCards, (card: ActionCard, index: number) => {
          Column() {
            Text(card.icon)
              .fontSize(28)
            
            Text(card.name)
              .fontSize(12)
              .fontColor(Color.White)
              .margin({ top: 5 })
          }
          .width(70)
          .height(80)
          .backgroundColor(this.highlightCard === index || this.highlightCard === -2 ? '#FF6B6B' : 'rgba(255,255,255,0.2)')
          .borderRadius(10)
          .justifyContent(FlexAlign.Center)
          .border({
            width: 2,
            color: this.highlightCard === index || this.highlightCard === -2 ? '#FF6B6B' : 'rgba(255,255,255,0.3)'
          })
          .opacity(this.highlightCard >= 0 && this.highlightCard !== index ? 0.5 : 1)
          .animation({
            duration: 300,
            curve: Curve.EaseInOut
          })
          .margin({ left: index === 0 ? 0 : 10 })
        }, (card: ActionCard, index: number) => index.toString())
      }
      .width('100%')
      .justifyContent(FlexAlign.Center)
    }
    .width('100%')
    .padding(15)
    .backgroundColor('rgba(255,255,255,0.1)')
    .borderRadius(15)
    .margin({ top: 15 })
  }
  
  @Builder
  buildTipText() {
    Column() {
      Text(this.tutorialSteps[this.tutorialStep] || 'ç‚¹å‡»"å¼€å§‹æ¼”ç¤º"æŸ¥çœ‹æ¸¸æˆçŽ©æ³•')
        .fontSize(16)
        .fontColor(Color.White)
        .textAlign(TextAlign.Center)
        .lineHeight(26)
        .padding(20)
    }
    .width('100%')
    .margin({ top: 20 })
    .padding(15)
    .backgroundColor('rgba(255,255,255,0.15)')
    .borderRadius(15)
  }
}

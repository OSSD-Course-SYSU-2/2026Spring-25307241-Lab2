  startAutoPlay(): void {
    this.isPlaying = true;
    this.tutorialStep = 0;
    this.playNextStep();
  }
  
  playNextStep(): void {
    if (this.tutorialStep >= this.tutorialSteps.length) {
      this.isPlaying = false;
      return;
    }
    
    // æ¸…é™¤ä¹‹å‰çš„é«˜äº®
    this.highlightPositions = [];
    this.highlightCard = -1;
    
    // æ ¹æ®æ­¥éª¤è®¾ç½®æ¼”ç¤ºæ•ˆæžœ
    switch (this.tutorialStep) {
      case 1: // å±•ç¤ºæ£‹ç›˜
        this.highlightPositions = [0, 1, 2, 3, 4, 5, 6, 7, 8];
        break;
      case 2: // å±•ç¤ºç›®æ ‡
        this.highlightPositions = [0, 1, 2];
        break;
      case 3: // å±•ç¤ºå¡ç‰Œ
        this.highlightCard = -2; // æ‰€æœ‰å¡ç‰Œ

    getCurrentWeekPlan() {
        const today = new Date();
        const weekStart = this.getWeekStart(today);
        const weekStartStr = weekStart.toISOString().split('T')[0];
        return this.data.weeklyPlans?.find(p => p.weekStart === weekStartStr);
    }
    // è·å–æŒ‡å®šå‘¨çš„è®­ç»ƒè®¡åˆ’
    getWeekPlanByDate(date) {
        const targetDate = new Date(date);
        const weekStart = this.getWeekStart(targetDate);
        const weekStartStr = weekStart.toISOString().split('T')[0];
        return this.data.weeklyPlans?.find(p => p.weekStart === weekStartStr);
    }
    // ä¿å­˜æˆ–æ›´æ–°å‘¨è®­ç»ƒè®¡åˆ’
    saveWeeklyPlan(plan) {
        if (!this.data.weeklyPlans) {
            this.data.weeklyPlans = [];
        }
        const existingIndex = this.data.weeklyPlans.findIndex(p => p.id === plan.id);
        if (existingIndex >= 0) {
            // æ›´æ–°ç°æœ‰è®¡åˆ’
            plan.updatedAt = new Date().toISOString();
            this.data.weeklyPlans[existingIndex] = plan;
        }
        else {
            // æ·»åŠ æ–°è®¡åˆ’
            this.data.weeklyPlans.push(plan);
        }
        this.save();
    }
    // åˆ é™¤å‘¨è®­ç»ƒè®¡åˆ’
    deleteWeeklyPlan(planId) {
        if (this.data.weeklyPlans) {
            this.data.weeklyPlans = this.data.weeklyPlans.filter(p => p.id !== planId);
            this.save();
        }
    }
    // åˆ›å»ºæ–°çš„å‘¨è®­ç»ƒè®¡åˆ’
    createWeeklyPlan(weekStartDate) {
        const weekStart = weekStartDate ? this.getWeekStart(weekStartDate) : this.getWeekStart(new Date());
        const weekEnd = new Date(weekStart);
        weekEnd.setDate(weekEnd.getDate() + 6);
        const dailyPlans = [];
        for (let i = 0; i < 7; i++) {
            const date = new Date(weekStart);
            date.setDate(date.getDate() + i);
            dailyPlans.push({
                dayOfWeek: i,
                date: date.toISOString().split('T')[0],
                moves: [],
                notes: ''
            });
        }
        const now = new Date().toISOString();
        const plan = {
            id: `plan-${Date.now()}`,
            weekStart: weekStart.toISOString().split('T')[0],
            weekEnd: weekEnd.toISOString().split('T')[0],
            dailyPlans: dailyPlans,
            notes: '',
            createdAt: now,
            updatedAt: now
        };
        return plan;
    }
    // è·å–å‘¨å¼€å§‹æ—¥æœŸï¼ˆå‘¨æ—¥ä¸ºä¸€å‘¨çš„å¼€å§‹ï¼‰
    getWeekStart(date) {
        const d = new Date(date);
        const day = d.getDay();
        d.setDate(d.getDate() - day);
        d.setHours(0, 0, 0, 0);
        return d;
    }
}

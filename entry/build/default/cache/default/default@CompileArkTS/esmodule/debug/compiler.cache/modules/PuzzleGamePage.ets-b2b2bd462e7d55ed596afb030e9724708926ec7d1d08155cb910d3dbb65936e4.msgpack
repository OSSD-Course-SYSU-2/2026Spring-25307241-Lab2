          Blank().layoutWeight(1)
          Text(`${this.playerScore.score}`)
            .fontSize(20)
            .fontWeight(FontWeight.Bold)
            .fontColor('#FFD700')
        }
        .width('100%')
        .margin({ top: 10 })
      }
      .width('85%')
      .padding(25)
      .backgroundColor('rgba(255,255,255,0.15)')
      .borderRadius(20)
      .margin({ bottom: 40 })
      
      Row() {
        Button('å†æ¥ä¸€å±€')
          .width('45%')
          .height(50)
          .backgroundColor('#667eea')
          .borderRadius(25)
          .fontColor(Color.White)
          .fontSize(18)
          .onClick(() => {
            this.showResult = false;
            this.startNewGame();
          })
        
        Button('è¿”å›')
          .width('45%')
          .height(50)
          .backgroundColor('rgba(255,255,255,0.3)')
          .borderRadius(25)
          .fontColor(Color.White)
          .fontSize(18)

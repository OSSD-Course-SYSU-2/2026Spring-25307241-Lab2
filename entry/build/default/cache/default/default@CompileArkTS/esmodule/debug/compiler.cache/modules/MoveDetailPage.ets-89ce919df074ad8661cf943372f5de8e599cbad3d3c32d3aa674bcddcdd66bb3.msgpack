  private dataStore: DataStore = DataStore.getInstance();
  
  aboutToAppear() {
    // è·å–è·¯ç”±å‚æ•°
    const params = router.getParams() as Record<string, string>;
    if (params && params['abbr']) {
      this.moveAbbr = params['abbr'] as string;
      this.loadMoveData();
    }
  }
  
  loadMoveData() {
    this.move = this.dataStore.getMove(this.moveAbbr) || null;
    this.records = this.dataStore.getMoveRecords(this.moveAbbr);
    if (this.move) {
      this.tipsText = this.move.tips;
    }
  }
  
  // æ ¼å¼åŒ–æ—¶é—´
  formatDuration(seconds: number): string {
    if (seconds < 60) return `${seconds}ç§’`;
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return secs > 0 ? `${mins}åˆ†${secs}ç§’` : `${mins}åˆ†é’Ÿ`;
  }
  
  // æ ¼å¼åŒ–æ—¥æœŸ
  formatDate(date: string): string {
    const parts = date.split('-');
    return `${parts[1]}æœˆ${parts[2]}æ—¥`;
  }
  
  // è·å–ç±»å‹å›¾æ ‡
  getTypeIcon(): string {
    if (!this.move) return 'â“';
    switch (this.move.type) {
      case 'jump': return 'ğŸ¦¶';
      case 'spin': return 'ğŸŒ€';
      case 'step': return 'ğŸ‘£';
      default: return 'â“';
    }
  }
  
  // è·å–ç±»å‹åç§°
  getTypeName(): string {
    if (!this.move) return 'æœªçŸ¥';
    switch (this.move.type) {
      case 'jump': return 'è·³è·ƒ';
      case 'spin': return 'æ—‹è½¬';
      case 'step': return 'æ­¥æ³•';
      default: return 'æœªçŸ¥';
    }
  }
  
  build() {
    Stack() {
      Column() {
        // é¡¶éƒ¨å¯¼èˆª
        Row() {
          Text('â†')
            .fontSize(24)
            .fontColor('#FFFFFF')
            .onClick(() => {
              router.back();
            })
          
          Text(this.move?.name || this.moveAbbr)
            .fontSize(20)
            .fontWeight(FontWeight.Bold)
            .fontColor('#FFFFFF')
            .margin({ left: 15 })
            .layoutWeight(1)
          
          Text('è®¾ç½®')
            .fontSize(14)
            .fontColor('#FFFFFF')
            .onClick(() => {
              this.showTipsEditor = true;
            })
        }
        .width('100%')
        .padding({ left: 20, right: 20, top: 15, bottom: 15 })
        
        // åŠ¨ä½œä¿¡æ¯å¡ç‰‡
        if (this.move) {
          this.buildMoveInfo()
        }
        
        // ç»ƒä¹ å†å²æ—¶é—´è½´
        Column() {
          Text('ç»ƒä¹ å†å²')
            .fontSize(18)
            .fontWeight(FontWeight.Bold)
            .fontColor('#FFFFFF')
            .margin({ bottom: 15 })
          
          if (this.records.length === 0) {
            Column() {
              Text('ğŸ“')
                .fontSize(40)
              Text('æš‚æ— ç»ƒä¹ è®°å½•')
                .fontSize(14)
                .fontColor('rgba(255, 255, 255, 0.6)')
                .margin({ top: 10 })
            }
            .width('100%')
            .height(150)
            .justifyContent(FlexAlign.Center)
          } else {
            List() {
              ForEach(this.records, (record: PracticeRecord, index: number) => {
                ListItem() {
                  this.buildTimelineItem(record, index)
                }
              })
            }
            .width('100%')
            .layoutWeight(1)
          }
        }
        .width('100%')
        .layoutWeight(1)
        .padding(20)
        .margin({ top: 10 })
      }
      .width('100%')
      .height('100%')
      .linearGradient({
        angle: 135,
        colors: [['#00D2FF', 0.0], ['#3A7BD5', 1.0]]
      })
      
      // åŠ¨ä½œè¦ç‚¹ç¼–è¾‘å¼¹çª—
      if (this.showTipsEditor) {
        this.buildTipsEditor()
      }
    }
    .width('100%')
    .height('100%')
  }
  
  @Builder
  buildMoveInfo() {
    Column() {
      Row() {
        Text(this.getTypeIcon())
          .fontSize(40)
        
        Column() {
          Text(this.move!.name)
            .fontSize(18)
            .fontWeight(FontWeight.Bold)
            .fontColor('#333333')
          
          Row() {
            Text(this.move!.abbr)
              .fontSize(14)
              .fontColor('#666666')
            
            Text(' | ')
              .fontSize(14)
              .fontColor('#CCCCCC')
            

            .fontWeight(FontWeight.Bold)
            .fontColor('#3A7BD5')
          Text('ç»ƒä¹ æ¬¡æ•°')
            .fontSize(12)
            .fontColor('#666666')
            .margin({ top: 5 })
        }
        .layoutWeight(1)
      }
      .width('100%')
      .margin({ top: 20 })
      
      // åŠ¨ä½œè¦ç‚¹
      if (this.move!.tips) {
        Column() {
          Text('åŠ¨ä½œè¦ç‚¹')
            .fontSize(14)
            .fontColor('#666666')
            .margin({ bottom: 8 })
          
          Text(this.move!.tips)
            .fontSize(14)
            .fontColor('#333333')
            .lineHeight(22)
        }
        .width('100%')
        .alignItems(HorizontalAlign.Start)
        .margin({ top: 15 })
        .padding(15)
        .backgroundColor('#F5F5F5')
        .borderRadius(10)
      }
    }
    .width('90%')
    .padding(20)
    .backgroundColor('#FFFFFF')
    .borderRadius(15)
    .margin({ top: 10 })
  }
  
  @Builder
  buildTimelineItem(record: PracticeRecord, index: number) {
    Row() {
      // æ—¶é—´è½´å·¦ä¾§
      Column() {
        Text(this.formatDate(record.date))
          .fontSize(12)
          .fontColor('rgba(255, 255, 255, 0.8)')
        
        Text(record.time)
          .fontSize(10)
          .fontColor('rgba(255, 255, 255, 0.6)')
      }
      .width(60)
      .alignItems(HorizontalAlign.End)
      
      // æ—¶é—´è½´ä¸­é—´
      Column() {
        Circle()
          .width(12)
          .height(12)
          .fill('#FFFFFF')
        
        if (index < this.records.length - 1) {
          Line()
            .width(2)
            .height(40)
            .backgroundColor('rgba(255, 255, 255, 0.3)')
        }
      }
      .width(20)
      .margin({ left: 10, right: 10 })
      
      // æ—¶é—´è½´å³ä¾§å†…å®¹
      Column() {
        Row() {
          Text(`æ—¶é•¿: ${this.formatDuration(record.duration)}`)
            .fontSize(14)
            .fontColor('#FFFFFF')
          
          Text(`ç–²åŠ³åº¦: ${record.fatigue}`)
            .fontSize(14)
            .fontColor('rgba(255, 255, 255, 0.8)')
            .margin({ left: 15 })
        }
        
        if (record.notes) {
          Text(record.notes)
            .fontSize(12)
            .fontColor('rgba(255, 255, 255, 0.6)')
            .margin({ top: 5 })
        }
      }
      .alignItems(HorizontalAlign.Start)
      .layoutWeight(1)
      .padding(15)
      .backgroundColor('rgba(255, 255, 255, 0.15)')
      .borderRadius(10)
    }
    .width('100%')
    .alignItems(VerticalAlign.Top)
    .margin({ bottom: 10 })
  }
  
  @Builder
  buildTipsEditor() {
    Column() {
      Column() {
        Text('è®¾ç½®åŠ¨ä½œè¦ç‚¹')
          .fontSize(18)
          .fontWeight(FontWeight.Bold)
          .fontColor('#333333')
          .margin({ bottom: 20 })
        
        TextArea({ placeholder: 'è¾“å…¥åŠ¨ä½œè¦ç‚¹ï¼Œå¦‚ï¼šèµ·è·³è§’åº¦ã€è½å†°å§¿åŠ¿ç­‰...', text: this.tipsText })
          .width('100%')

            .fontWeight(FontWeight.Bold)
            .fontColor('#3A7BD5')
          Text('ç´¯è®¡æ—¶é•¿')
            .fontSize(12)
            .fontColor('#666666')
            .margin({ top: 5 })
        }
        .layoutWeight(1)
        
        Column() {
          Text(this.move!.practiceCount.toString())

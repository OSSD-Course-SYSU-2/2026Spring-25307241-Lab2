    } else if (goe < 0) {
      return '#F44336'; // çº¢è‰²
    } else {
      return '#FFFFFF'; // ç™½è‰²
    }
  }
  
  // è®¡ç®—æ€»åˆ†
  calculateTotalScore(): void {
    this.totalScore = this.elementList.reduce((sum, element) => {

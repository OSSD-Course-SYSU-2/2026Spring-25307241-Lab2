  // èŽ·å–å½“å‰åˆ†ç±»çš„å…ƒç´ åˆ—è¡¨
  getCurrentElements(): string[] {
    switch (this.selectedCategory) {
      case 'jump':
        return this.jumps;
      case 'spin':
        return this.spins;
      case 'step':
        return this.steps;
      default:
        return this.jumps;

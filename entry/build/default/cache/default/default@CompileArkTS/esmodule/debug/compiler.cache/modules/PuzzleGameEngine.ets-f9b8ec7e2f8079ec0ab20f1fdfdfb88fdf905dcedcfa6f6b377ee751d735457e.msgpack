import { Medal, MedalType, ActionType, ActionCard, TargetPattern, GameMode, GameState, PlayerScore, GameConfig } from '../../viewmodel/PuzzleGameModel';
// æ¸¸æˆå¼•æ“
export class PuzzleGameEngine {
    constructor() {
        // æ£‹ç›˜çŠ¶æ€ï¼ˆ3x3 = 9ä¸ªæ ¼å­ï¼‰
        this.board = [];
        // å½“å‰æ‰‹ç‰Œ
        this.handCards = [];
        // ç›®æ ‡å›¾æ¡ˆåˆ—è¡¨
        this.targetPatterns = [];
        // å½“å‰éœ€è¦å®Œæˆçš„ç›®æ ‡ç´¢å¼•
        this.currentTargetIndex = 0;
        // æ¸¸æˆçŠ¶æ€
        this.gameState = GameState.READY;
        // ç©å®¶æˆç»©
        this.playerScore = new PlayerScore();
        // æ¸¸æˆé…ç½®
        this.config = new GameConfig();
        // æ¸¸æˆæ¨¡å¼
        this.gameMode = GameMode.CLASSIC;
        // å¼€å§‹æ—¶é—´
        this.startTime = 0;
        // æ‰€æœ‰å¯ç”¨çš„åŠ¨ä½œå¡ç‰Œï¼ˆ15ç§ï¼‰
        this.allActionCards = [
            new ActionCard(ActionType.SPIN, 'æ—‹è½¬', 'ç¿»è½¬æ•´åˆ—/æ•´å †å¥–ç‰Œ', 2, 'ğŸ”„'),
            new ActionCard(ActionType.JUMP, 'è·³è·ƒ', 'äº¤æ¢æ£‹ç›˜ä¸Šä¸¤å †å¥–ç‰Œ', 3, 'ğŸ¦˜'),
            new ActionCard(ActionType.POSE, 'å§¿æ€', 'æŠŠç›¸é‚»å¥–ç‰Œå †å åˆ°ç›®æ ‡æ ¼', 2, 'ğŸ’ƒ'),
            new ActionCard(ActionType.PIROUETTE, 'æ»è½¬', 'äº¤æ¢ä¾§è¾¹å’ŒåŒ¹é…å¥–ç‰Œ', 4, 'ğŸ€'),
            new ActionCard(ActionType.AXEL, 'é˜¿å…‹å¡å°”', 'é«˜çº§è·³è·ƒåŠ¨ä½œ', 5, 'â­'),
            new ActionCard(ActionType.LUTZ, 'å‹¾æ‰‹è·³', 'éš¾åº¦è·³è·ƒåŠ¨ä½œ', 4, 'ğŸŒŸ'),
            new ActionCard(ActionType.FLIP, 'åå†…ç‚¹å†°', 'ç‚¹å†°è·³è·ƒåŠ¨ä½œ', 3, 'âœ¨'),
            new ActionCard(ActionType.LOOP, 'åå¤–ç»“ç¯', 'ç»“ç¯è·³è·ƒåŠ¨ä½œ', 3, 'ğŸ’«'),
            new ActionCard(ActionType.SALCHOW, 'åå†…ç»“ç¯', 'å†…ç»“ç¯è·³è·ƒ', 3, 'ğŸ”¥'),
            new ActionCard(ActionType.TOE_LOOP, 'åå¤–ç‚¹å†°', 'ç‚¹å†°è·³è·ƒåŸºç¡€', 2, 'â„ï¸'),
            new ActionCard(ActionType.CAMEL, 'éª†é©¼æ—‹è½¬', 'è¹²æ—‹è½¬åŠ¨ä½œ', 2, 'ğŸª'),
            new ActionCard(ActionType.SIT, 'è¹²æ—‹è½¬', 'è¹²å§¿æ—‹è½¬åŠ¨ä½œ', 2, 'ğŸ¦µ'),
            new ActionCard(ActionType.UPRIGHT, 'ç›´ç«‹æ—‹è½¬', 'ç›´ç«‹æ—‹è½¬åŠ¨ä½œ', 1, 'ğŸ§'),
            new ActionCard(ActionType.SPIRAL, 'èºæ—‹çº¿', 'èºæ—‹çº¿åŠ¨ä½œ', 3, 'ğŸŒ€'),
            new ActionCard(ActionType.STEP, 'æ¥ç»­æ­¥', 'æ­¥ä¼è¿æ¥åŠ¨ä½œ', 1, 'ğŸ‘£')
        ];
    }
    // åˆå§‹åŒ–æ¸¸æˆ
    initializeGame(mode, config) {
        this.gameMode = mode;
        if (config) {
            this.config = config;
        }
        // åˆå§‹åŒ–æ£‹ç›˜
        this.initializeBoard();
        // ç”Ÿæˆç›®æ ‡å›¾æ¡ˆ
        this.generateTargetPatterns();
        // å‘æ”¾åˆå§‹æ‰‹ç‰Œ
        this.dealCards(5);
        // é‡ç½®æ¸¸æˆçŠ¶æ€
        this.gameState = GameState.READY;
        this.currentTargetIndex = 0;
        this.playerScore = new PlayerScore();
        this.startTime = Date.now();
    }
    // åˆå§‹åŒ–3x3æ£‹ç›˜
    initializeBoard() {
        this.board = [];
        for (let i = 0; i < 9; i++) {
            this.board.push(new Medal(Medal.random(), `medal_${i}`));
        }
    }
    // ç”Ÿæˆç›®æ ‡å›¾æ¡ˆï¼ˆ6ç»„ï¼‰
    generateTargetPatterns() {
        this.targetPatterns = [];
        for (let i = 0; i < this.config.totalPatterns; i++) {
            const pattern = this.generateRandomPattern();
            this.targetPatterns.push(pattern);
        }
    }
    // ç”Ÿæˆéšæœºç›®æ ‡å›¾æ¡ˆ
    generateRandomPattern() {
        // éšæœºé€‰æ‹©ä¸€è¡Œã€ä¸€åˆ—æˆ–å¯¹è§’çº¿
        const patternTypes = ['row', 'column', 'diagonal'];
        const type = patternTypes[Math.floor(Math.random() * patternTypes.length)];
        let positions = [];
        let description = '';
        switch (type) {
            case 'row':
                const row = Math.floor(Math.random() * 3);
                positions = [row * 3, row * 3 + 1, row * 3 + 2];
                description = `ç¬¬${row + 1}è¡Œ`;
                break;
            case 'column':
                const col = Math.floor(Math.random() * 3);
                positions = [col, col + 3, col + 6];
                description = `ç¬¬${col + 1}åˆ—`;
                break;
            case 'diagonal':
                if (Math.random() > 0.5) {
                    positions = [0, 4, 8];
                    description = 'ä¸»å¯¹è§’çº¿';
                }
                else {
                    positions = [2, 4, 6];
                    description = 'å‰¯å¯¹è§’çº¿';
                }
                break;
        }
        // éšæœºç”Ÿæˆéœ€è¦çš„å¥–ç‰Œç»„åˆ
        const medals = [];
        for (let i = 0; i < 3; i++) {
            medals.push(Medal.random());
        }
        return new TargetPattern(positions, medals, description);
    }
    // å‘æ”¾åŠ¨ä½œå¡ç‰Œ
    dealCards(count) {
        this.handCards = [];
        const shuffled = [...this.allActionCards].sort(() => Math.random() - 0.5);
        for (let i = 0; i < Math.min(count, shuffled.length); i++) {
            this.handCards.push(shuffled[i]);
        }
    }
    // å¼€å§‹æ¸¸æˆ
    startGame() {
        if (this.gameState === GameState.READY) {
            this.gameState = GameState.PLAYING;
            this.startTime = Date.now();
        }
    }
    // æ‰§è¡ŒåŠ¨ä½œå¡ç‰Œ
    executeAction(cardIndex, params) {
        if (this.gameState !== GameState.PLAYING) {
            return false;
        }
        if (cardIndex < 0 || cardIndex >= this.handCards.length) {
            return false;
        }
        const card = this.handCards[cardIndex];
        let success = false;
        try {
            switch (card.type) {
                case ActionType.SPIN:
                    success = this.executeSpin(params['column']);
                    break;
                case ActionType.JUMP:
                    success = this.executeJump(params['pos1'], params['pos2']);
                    break;
                case ActionType.POSE:
                    success = this.executePose(params['from'], params['to']);
                    break;
                case ActionType.PIROUETTE:
                    success = this.executePirouette(params['side'], params['target']);
                    break;
                case ActionType.AXEL:
                    success = this.executeAxel(params['pos']);
                    break;
                case ActionType.LUTZ:
                    success = this.executeLutz(params['pos']);
                    break;
                case ActionType.FLIP:
                    success = this.executeFlip(params['pos']);
                    break;
                case ActionType.LOOP:
                    success = this.executeLoop(params['pos']);
                    break;
                case ActionType.SALCHOW:
                    success = this.executeSalchow(params['pos']);
                    break;
                case ActionType.TOE_LOOP:
                    success = this.executeToeLoop(params['pos']);
                    break;
                case ActionType.CAMEL:
                    success = this.executeCamel(params['pos']);
                    break;
                case ActionType.SIT:
                    success = this.executeSit(params['pos']);
                    break;
                case ActionType.UPRIGHT:
                    success = this.executeUpright(params['pos']);
                    break;
                case ActionType.SPIRAL:
                    success = this.executeSpiral(params['pos']);
                    break;
                case ActionType.STEP:
                    success = this.executeStep(params['pos']);
                    break;
            }
            if (success) {
                // ç§»é™¤ä½¿ç”¨çš„å¡ç‰Œ
                this.handCards.splice(cardIndex, 1);
                this.playerScore.moves++;
                // æ£€æŸ¥æ˜¯å¦å®Œæˆå½“å‰ç›®æ ‡
                this.checkPatternCompletion();
                // è¡¥å……æ‰‹ç‰Œ
                if (this.handCards.length < 3) {
                    this.dealCards(5 - this.handCards.length);
                }
            }
        }
        catch (error) {
            success = false;
            this.playerScore.mistakes++;
        }
        return success;
    }
    // SpinåŠ¨ä½œï¼šç¿»è½¬æ•´åˆ—
    executeSpin(column) {
        if (column === undefined) {
            column = Math.floor(Math.random() * 3);
        }
        if (column < 0 || column > 2)
            return false;
        // ç¿»è½¬è¯¥åˆ—çš„å¥–ç‰Œé¡ºåº
        const temp = this.board[column];
        this.board[column] = this.board[column + 6];
        this.board[column + 6] = temp;
        const temp2 = this.board[column + 3];
        this.board[column + 3] = this.board[column + 6];
        this.board[column + 6] = temp2;
        return true;
    }
    // JumpåŠ¨ä½œï¼šäº¤æ¢ä¸¤å †å¥–ç‰Œ
    executeJump(pos1, pos2) {
        if (pos1 === undefined || pos2 === undefined) {
            // éšæœºé€‰æ‹©ä¸¤ä¸ªä½ç½®
            pos1 = Math.floor(Math.random() * 9);
            do {
                pos2 = Math.floor(Math.random() * 9);
            } while (pos2 === pos1);
        }
        if (pos1 < 0 || pos1 > 8 || pos2 < 0 || pos2 > 8)
            return false;
        const temp = this.board[pos1];
        this.board[pos1] = this.board[pos2];
        this.board[pos2] = temp;
        return true;
    }
    // PoseåŠ¨ä½œï¼šå †å ç›¸é‚»å¥–ç‰Œ
    executePose(from, to) {
        if (from === undefined || to === undefined) {
            // éšæœºé€‰æ‹©ç›¸é‚»ä½ç½®
            from = Math.floor(Math.random() * 9);
            const neighbors = this.getNeighbors(from);
            to = neighbors[Math.floor(Math.random() * neighbors.length)];
        }
        if (!this.areAdjacent(from, to))
            return false;
        // äº¤æ¢ç›¸é‚»ä½ç½®
        const temp = this.board[from];
        this.board[from] = this.board[to];
        this.board[to] = temp;
        return true;
    }
    // PirouetteåŠ¨ä½œï¼šäº¤æ¢ä¾§è¾¹å’ŒåŒ¹é…å¥–ç‰Œ
    executePirouette(side, target) {
        // ç®€åŒ–å®ç°ï¼šéšæœºäº¤æ¢ä¸¤ä¸ªä½ç½®
        return this.executeJump(side, target);
    }
    // å…¶ä»–åŠ¨ä½œçš„ç®€åŒ–å®ç°
    executeAxel(pos) {
        const pos2 = Math.floor(Math.random() * 9);
        return this.executeJump(pos, pos2);
    }
    executeLutz(pos) {
        return this.executeSpin(pos % 3);
    }
    executeFlip(pos) {
        const pos2 = Math.floor(Math.random() * 9);
        return this.executeJump(pos, pos2);
    }
    executeLoop(pos) {
        return this.executeSpin(pos % 3);
    }
    executeSalchow(pos) {
        const pos2 = Math.floor(Math.random() * 9);
        return this.executeJump(pos, pos2);
    }
    executeToeLoop(pos) {
        return this.executeSpin(pos % 3);
    }
    executeCamel(pos) {
        return this.executeSpin(pos % 3);
    }
    executeSit(pos) {
        return this.executeSpin(pos % 3);
    }
    executeUpright(pos) {
        return this.executeSpin(pos % 3);
    }
    executeSpiral(pos) {
        const pos2 = Math.floor(Math.random() * 9);
        return this.executeJump(pos, pos2);
    }
    executeStep(pos) {
        const pos2 = Math.floor(Math.random() * 9);
        return this.executeJump(pos, pos2);
    }
    // è·å–ç›¸é‚»ä½ç½®
    getNeighbors(pos) {
        const neighbors = [];
        const row = Math.floor(pos / 3);
        const col = pos % 3;
        if (row > 0)
            neighbors.push(pos - 3); // ä¸Š
        if (row < 2)
            neighbors.push(pos + 3); // ä¸‹
        if (col > 0)
            neighbors.push(pos - 1); // å·¦
        if (col < 2)
            neighbors.push(pos + 1); // å³
        return neighbors;
    }
    // åˆ¤æ–­ä¸¤ä¸ªä½ç½®æ˜¯å¦ç›¸é‚»
    areAdjacent(pos1, pos2) {
        return this.getNeighbors(pos1).includes(pos2);
    }
    // æ£€æŸ¥å›¾æ¡ˆå®Œæˆ
    checkPatternCompletion() {
        if (this.currentTargetIndex >= this.targetPatterns.length) {
            return;
        }
        const target = this.targetPatterns[this.currentTargetIndex];
        let completed = true;
        for (let i = 0; i < target.positions.length; i++) {
            const pos = target.positions[i];
            if (this.board[pos].type !== target.requiredMedals[i]) {
                completed = false;
                break;
            }
        }
        if (completed) {
            this.currentTargetIndex++;
            this.playerScore.patternsCompleted++;
            // æ£€æŸ¥æ˜¯å¦å…¨éƒ¨å®Œæˆ
            if (this.currentTargetIndex >= this.targetPatterns.length) {
                this.completeGame();
            }
        }
    }
    // å®Œæˆæ¸¸æˆ
    completeGame() {
        this.gameState = GameState.COMPLETED;
        this.playerScore.time = Math.floor((Date.now() - this.startTime) / 1000);
        this.calculateScore();
    }
    // è®¡ç®—åˆ†æ•°
    calculateScore() {
        // åŸºç¡€åˆ† = å®Œæˆå›¾æ¡ˆæ•° * 100
        let score = this.playerScore.patternsCompleted * 100;
        // æ—¶é—´å¥–åŠ±
        const timeBonus = Math.max(0, 300 - this.playerScore.time);
        score += timeBonus;
        // å¤±è¯¯æƒ©ç½š
        score -= this.playerScore.mistakes * 20;
        // ç§»åŠ¨æ•ˆç‡å¥–åŠ±
        const efficiency = this.playerScore.patternsCompleted / Math.max(1, this.playerScore.moves);
        score += Math.floor(efficiency * 50);
        this.playerScore.score = Math.max(0, score);
        // ç¡®å®šå¥–ç‰Œ
        if (this.playerScore.mistakes === 0) {
            this.playerScore.medal = MedalType.GOLD;
        }
        else if (this.playerScore.mistakes === 1) {
            this.playerScore.medal = MedalType.SILVER;
        }
        else {
            this.playerScore.medal = MedalType.BRONZE;
        }
    }
    // è·å–æ£‹ç›˜çŠ¶æ€
    getBoard() {
        return [...this.board];
    }
    // è·å–æ‰‹ç‰Œ
    getHandCards() {
        return [...this.handCards];
    }
    // è·å–å½“å‰ç›®æ ‡
    getCurrentTarget() {
        if (this.currentTargetIndex < this.targetPatterns.length) {
            return this.targetPatterns[this.currentTargetIndex];
        }
        return null;
    }
    // è·å–æ‰€æœ‰ç›®æ ‡
    getAllTargets() {
        return [...this.targetPatterns];
    }
    // è·å–æ¸¸æˆçŠ¶æ€
    getGameState() {
        return this.gameState;
    }
    // è·å–ç©å®¶æˆç»©
    getPlayerScore() {
        return this.playerScore;
    }
    // è·å–æ¸¸æˆæ¨¡å¼
    getGameMode() {
        return this.gameMode;
    }
    // æš‚åœæ¸¸æˆ
    pauseGame() {
        if (this.gameState === GameState.PLAYING) {
            this.gameState = GameState.PAUSED;
        }
    }
    // æ¢å¤æ¸¸æˆ
    resumeGame() {
        if (this.gameState === GameState.PAUSED) {
            this.gameState = GameState.PLAYING;
        }
    }
    // é‡æ–°å¼€å§‹
    restartGame() {
        this.initializeGame(this.gameMode, this.config);
    }
    // ç”Ÿæˆæ¯æ—¥æŒ‘æˆ˜ç§å­
    static getDailySeed() {
        const today = new Date();
        const year = today.getFullYear();
        const month = String(today.getMonth() + 1).padStart(2, '0');
        const day = String(today.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }
}

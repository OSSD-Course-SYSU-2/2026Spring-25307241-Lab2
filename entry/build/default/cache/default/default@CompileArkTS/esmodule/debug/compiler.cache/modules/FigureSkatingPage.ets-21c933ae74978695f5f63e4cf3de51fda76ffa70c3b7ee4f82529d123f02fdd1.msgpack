              .margin({ right: 8, bottom: 8 })
              .backgroundColor(
                this.isCombinationMode
                  ? (this.combinationElements.includes(element) ? '#FF6B6B' : '#E0E0E0')
                  : (this.currentElement === element ? '#FF6B6B' : '#E0E0E0')
              )
              .fontColor(
                this.isCombinationMode
                  ? (this.combinationElements.includes(element) ? Color.White : Color.Black)
                  : (this.currentElement === element ? Color.White : Color.Black)
              )
              .onClick(() => {
                if (this.isCombinationMode) {
                  // è¿è·³æ¨¡å¼ï¼šç›´æ¥æ·»åŠ åˆ°è¿è·³ç»„åˆ
                  if (this.combinationElements.length < 3 && !this.combinationElements.includes(element)) {
                    const baseVal = this.baseValues.get(element) || 0;
                    this.combinationElements.push(element);
                    this.combinationBaseValues.push(baseVal);
                  }
                } else {
                  // å•è·³æ¨¡å¼ï¼šé€‰æ‹©å½“å‰åŠ¨ä½œ
                  this.currentElement = element;
                  this.updateBaseValue();
                }
              })
          })
        }
        .width('100%')
      }
      .width('90%')
      .padding(15)
      .backgroundColor(Color.White)
      .borderRadius(10)
      .margin({ bottom: 20 })

      // è¿è·³æ¨¡å¼ï¼šæ˜¾ç¤ºå·²é€‰æ‹©çš„è¿è·³ç»„åˆ
      if (this.isCombinationMode && this.combinationElements.length > 0) {
        Column() {
          Text('è¿è·³ç»„åˆ')
            .fontSize(16)
            .fontWeight(FontWeight.Medium)
            .margin({ bottom: 10 })

          Row() {
            ForEach(this.combinationElements, (element: string, index: number) => {
              Row() {
                Text(element)
                  .fontSize(16)
                  .fontWeight(FontWeight.Bold)
                  .fontColor('#FF6B6B')
                if (index < this.combinationElements.length - 1) {
                  Text(' + ')
                    .fontSize(16)
                }
              }
            })
          }
          .margin({ bottom: 10 })

          Row() {
            Text('å„åŸºç¡€åˆ†å€¼: ')
              .fontSize(14)
            Text(this.combinationBaseValues.map(v => v.toFixed(2)).join(' + '))
              .fontSize(14)
              .fontColor('#4CAF50')
          }
          .margin({ bottom: 10 })

          Row() {
            Text('è¿è·³æ€»åŸºç¡€åˆ†å€¼: ')
              .fontSize(14)
            Text(ScoreCalculator.calculateCombinationBaseValue(this.combinationBaseValues).toFixed(2))
              .fontSize(18)
              .fontWeight(FontWeight.Bold)
              .fontColor('#4CAF50')
          }
        }
        .width('90%')
        .padding(15)
        .backgroundColor(Color.White)
        .borderRadius(10)
        .margin({ bottom: 20 })
      }

      // å•è·³æ¨¡å¼ï¼šåŸºç¡€åˆ†å€¼æ˜¾ç¤º
      if (!this.isCombinationMode && this.currentElement !== '') {
        Column() {
          Row() {
            Text('åŠ¨ä½œ: ')
              .fontSize(16)
            Text(this.currentElement)
              .fontSize(18)
              .fontWeight(FontWeight.Bold)
              .fontColor('#FF6B6B')
          }
          .margin({ bottom: 10 })

          Row() {
            Text('åŸºç¡€åˆ†å€¼: ')
              .fontSize(16)
            Text(this.baseValue)
              .fontSize(18)
              .fontWeight(FontWeight.Bold)
              .fontColor('#4CAF50')
          }
        }
        .width('90%')
        .padding(15)
        .backgroundColor(Color.White)
        .borderRadius(10)
        .margin({ bottom: 20 })
      }

      // GOEè¯„åˆ†åŒºåŸŸ
      if ((this.isCombinationMode && this.combinationElements.length >= 2) ||
          (!this.isCombinationMode && this.currentElement !== '')) {
        Column() {
          Text('è£åˆ¤GOEè¯„åˆ† (-5 åˆ° +5)')
            .fontSize(16)
            .fontWeight(FontWeight.Medium)
            .margin({ bottom: 10 })

          ForEach([0, 1, 2, 3, 4, 5, 6, 7, 8], (index: number) => {
            Row() {
              Text(`è£åˆ¤ ${index + 1}:`)
                .fontSize(14)
                .width(60)
              TextInput({ text: this.goeScores[index] })
                .width(80)
                .height(40)
                .type(InputType.Number)
                .onChange((value: string) => {
                  this.goeScores[index] = value;
                })
            }
            .width('100%')
            .justifyContent(FlexAlign.Start)
            .margin({ bottom: 8 })
          })
        }
        .width('90%')
        .padding(15)
        .backgroundColor(Color.White)
        .borderRadius(10)
        .margin({ bottom: 20 })
        Column() {
          Text('è£åˆ¤GOEè¯„åˆ† (-5 åˆ° +5)')
            .fontSize(16)
            .fontWeight(FontWeight.Medium)
            .margin({ bottom: 10 })

          ForEach([0, 1, 2, 3, 4, 5, 6, 7, 8], (index: number) => {
            Row() {
              Text(`è£åˆ¤ ${index + 1}:`)
                .fontSize(14)
                .width(60)
              TextInput({ text: this.goeScores[index] })
                .width(80)
                .height(40)
                .type(InputType.Number)
                .onChange((value: string) => {
                  this.goeScores[index] = value;
                })
            }
            .width('100%')
            .justifyContent(FlexAlign.Start)
            .margin({ bottom: 8 })
          })
        }
        .width('90%')
        .padding(15)
        .backgroundColor(Color.White)
        .borderRadius(10)
        .margin({ bottom: 20 })

        // æ·»åŠ åŠ¨ä½œæŒ‰é’®
        Row() {
          if (this.isCombinationMode) {
            Button('å®Œæˆè¿è·³')
              .width('45%')
              .height(50)
              .fontSize(16)
              .backgroundColor('#4CAF50')
              .enabled(this.combinationElements.length >= 2)
              .onClick(() => {
                this.addCombination();
              })

            Button('æ¸…ç©ºè¿è·³')
              .width('45%')
              .height(50)
              .fontSize(16)
              .backgroundColor('#FF9800')
              .onClick(() => {
                this.clearCombination();
              })
          } else {
            Button('æ·»åŠ åŠ¨ä½œ')
              .width('45%')
              .height(50)
              .fontSize(16)
              .backgroundColor('#4CAF50')
              .onClick(() => {
                this.addElement();
              })

            Button('æ¸…ç©º')
              .width('45%')
              .height(50)
              .fontSize(16)
              .backgroundColor('#FF9800')
              .onClick(() => {
                this.clearCurrent();
              })
          }
        }
        .width('90%')
        .justifyContent(FlexAlign.SpaceBetween)
        .margin({ bottom: 20 })
      }

      // å·²æ·»åŠ åŠ¨ä½œåˆ—è¡¨
      if (this.elementsList.length > 0 || this.combinationList.length > 0) {
        Column() {
          Text('å·²æ·»åŠ åŠ¨ä½œ')
            .fontSize(16)
            .fontWeight(FontWeight.Medium)
            .margin({ bottom: 10 })

          // å•è·³åˆ—è¡¨
          ForEach(this.elementsList, (item: SkatingScore, index: number) => {
            Row() {
              Text(`${index + 1}. ${item.element}`)
                .fontSize(14)
                .layoutWeight(1)
              Text(`åŸºç¡€: ${item.baseValue.toFixed(2)}`)
                .fontSize(14)
                .width(100)
              Text(`å¾—åˆ†: ${item.finalScore.toFixed(2)}`)
                .fontSize(14)
                .fontColor('#FF6B6B')
                .width(100)
              Button('åˆ é™¤')
                .width(50)
                .height(30)
                .fontSize(12)
                .backgroundColor('#FF4444')
                .onClick(() => {
                  this.removeElement(index);
                })
            }
            .width('100%')
            .justifyContent(FlexAlign.SpaceBetween)
            .padding({ top: 8, bottom: 8 })
            .borderWidth({ bottom: 1 })
            .borderColor('#E0E0E0')
          })

          // è¿è·³åˆ—è¡¨
          ForEach(this.combinationList, (item: CombinationJump, index: number) => {
            Column() {
              Row() {
                Text(`${this.elementsList.length + index + 1}. ${item.elements.join(' + ')} (è¿è·³)`)
                  .fontSize(14)
                  .layoutWeight(1)
                Button('åˆ é™¤')
                  .width(50)
                  .height(30)
                  .fontSize(12)
                  .backgroundColor('#FF4444')
                  .onClick(() => {
                    this.removeCombination(index);
                  })
              }
              .width('100%')
              .justifyContent(FlexAlign.SpaceBetween)
              .padding({ top: 8, bottom: 4 })

              Row() {
                Text(`å„åŸºç¡€: ${item.baseValues.map(v => v.toFixed(2)).join(' + ')}`)
                  .fontSize(12)
                  .fontColor('#666666')
                  .layoutWeight(1)
                Text(`æ€»åŸºç¡€: ${item.totalBaseValue.toFixed(2)}`)
                  .fontSize(12)
                  .fontColor('#4CAF50')
                  .width(100)
                Text(`å¾—åˆ†: ${item.finalScore.toFixed(2)}`)
                  .fontSize(14)
                  .fontColor('#FF6B6B')
                  .width(100)
              }
              .width('100%')
              .padding({ bottom: 8 })
            }
            .width('100%')
            .borderWidth({ bottom: 1 })
            .borderColor('#E0E0E0')
          })
        }
        .width('90%')
        .padding(15)
        .backgroundColor(Color.White)
        .borderRadius(10)
        .margin({ bottom: 20 })

        // è®¡ç®—æ€»åˆ†æŒ‰é’®
        Button('è®¡ç®—æ€»åˆ†')
          .width('90%')
          .height(50)
          .fontSize(18)
          .backgroundColor('#FF6B6B')
          .onClick(() => {
            this.calculateTotal();
          })
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F0F0F0')
  }

  updateBaseValue() {
    const value = this.baseValues.get(this.currentElement);
    if (value !== undefined) {
      this.baseValue = value.toFixed(2);
    }
  }

  addElement() {
    if (this.currentElement === '') {
      return;
    }

    const baseVal = this.baseValues.get(this.currentElement) || 0;
    const goeValues: number[] = [];
    
    for (let i = 0; i < 9; i++) {
      const goe = parseFloat(this.goeScores[i]);
      if (!isNaN(goe)) {
        goeValues.push(goe);
      }
    }

    const finalScore = ScoreCalculator.calculateElementScore(baseVal, goeValues);
    
    const score = new SkatingScore(
      this.currentElement,
      baseVal,
      goeValues,
      finalScore
    );

    this.elementsList.push(score);
    this.clearCurrent();
  }

  removeElement(index: number) {
    this.elementsList.splice(index, 1);
    this.calculateTotal();
  }

  clearCurrent() {
    this.currentElement = '';
    this.baseValue = '';
    this.goeScores = ['', '', '', '', '', '', '', '', ''];
  }

  calculateTotal() {
    let total = 0;
    for (const item of this.elementsList) {
      total += item.finalScore;
    }
    for (const item of this.combinationList) {
      total += item.finalScore;
    }
    this.totalScore = total.toFixed(2);
  }

  // è¿è·³ç›¸å…³æ–¹æ³•
  addToCombination() {
    if (this.currentElement === '' || this.combinationElements.length >= 3) {
      return;
    }

    const baseVal = this.baseValues.get(this.currentElement) || 0;
    this.combinationElements.push(this.currentElement);
    this.combinationBaseValues.push(baseVal);
    this.currentElement = '';
    this.baseValue = '';
  }

  addCombination() {
    if (this.combinationElements.length < 2) {
      return;
    }

    const goeValues: number[] = [];
    for (let i = 0; i < 9; i++) {
      const goe = parseFloat(this.goeScores[i]);
      if (!isNaN(goe)) {
        goeValues.push(goe);
      }
    }

    const combination = ScoreCalculator.createCombinationJump(
      [...this.combinationElements],
      [...this.combinationBaseValues],
      goeValues
    );

    this.combinationList.push(combination);
    this.clearCombination();
  }

  removeCombination(index: number) {
    this.combinationList.splice(index, 1);
    this.calculateTotal();
  }

  clearCombination() {
    this.combinationElements = [];
    this.combinationBaseValues = [];
    this.currentElement = '';
    this.baseValue = '';
    this.goeScores = ['', '', '', '', '', '', '', '', ''];
  }
}

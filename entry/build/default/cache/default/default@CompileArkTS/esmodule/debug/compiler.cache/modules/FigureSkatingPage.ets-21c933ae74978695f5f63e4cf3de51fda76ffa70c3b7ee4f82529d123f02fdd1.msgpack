          .fontColor(!this.isCombinationMode ? Color.White : Color.Black)
          .onClick(() => {
            this.isCombinationMode = false;
            this.clearCombination();
          })

        Button('è¿è·³æ¨¡å¼')
          .width('45%')
          .height(45)
          .fontSize(16)
          .backgroundColor(this.isCombinationMode ? '#4CAF50' : '#E0E0E0')
          .fontColor(this.isCombinationMode ? Color.White : Color.Black)
          .onClick(() => {
            this.isCombinationMode = true;
            this.clearCurrent();
          })
      }
      .width('90%')
      .justifyContent(FlexAlign.SpaceBetween)
      .margin({ bottom: 20 })

      // åŠ¨ä½œé€‰æ‹©åŒºåŸŸ
      Column() {
        Text(this.isCombinationMode ? 'é€‰æ‹©è¿è·³åŠ¨ä½œï¼ˆæœ€å¤š3ä¸ªï¼‰' : 'é€‰æ‹©åŠ¨ä½œ')
          .fontSize(16)

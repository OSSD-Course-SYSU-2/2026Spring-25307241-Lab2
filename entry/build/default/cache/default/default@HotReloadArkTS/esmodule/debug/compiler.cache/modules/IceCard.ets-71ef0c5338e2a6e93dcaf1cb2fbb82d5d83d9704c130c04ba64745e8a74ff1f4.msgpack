@Component
export struct IceCard {
  @Prop title: string = '';                    // å¡ç‰‡æ ‡é¢˜
  @Prop subtitle: string = '';                 // å‰¯æ ‡é¢˜
  @Prop showBorder: boolean = true;            // æ˜¯å¦æ˜¾ç¤ºè¾¹æ¡†
  @Prop cardPadding: number = 16;              // å†…è¾¹è·
  @Prop cardMargin: number = 8;                // å¤–è¾¹è·

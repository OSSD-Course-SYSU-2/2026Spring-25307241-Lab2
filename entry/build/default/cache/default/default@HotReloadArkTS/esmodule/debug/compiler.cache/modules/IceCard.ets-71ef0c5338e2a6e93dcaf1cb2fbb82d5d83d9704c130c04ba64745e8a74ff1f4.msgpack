  build() {
    Column() {
      // æ ‡é¢˜åŒºåŸŸ
      if (this.title) {
        Row() {
          Text(this.title)
            .fontSize(16)
            .fontWeight(FontWeight.Bold)
            .fontColor('#333333')
          
          if (this.subtitle) {
            Text(this.subtitle)
              .fontSize(12)
              .fontColor('#999999')
              .margin({ left: 8 })
          }
          
          Blank()
          
          if (this.onCardClick) {
            Text('â€º')
              .fontSize(20)
              .fontColor('#999999')
          }
        }
        .width('100%')
        .margin({ bottom: 12 })
      }
      
      // å†…å®¹åŒºåŸŸ
      if (this.content) {
        this.content();
      }
    }
    .width('100%')
    .padding(this.cardPadding)
    .margin(this.cardMargin)
    .backgroundColor(this.cardBackgroundColor)
    .borderRadius(this.cardBorderRadius)
    .shadow({
      radius: this.showBorder ? 8 : 0,
      color: '#1A000000',
      offsetX: 0,
      offsetY: 2
    })
    .onClick(() => {
      if (this.onCardClick) {
        this.onCardClick();
      }
    })
  }
}
